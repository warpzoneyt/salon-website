<style>
:root{
--navy:#0b1f3a;
--navy2:#132d50;
--beige:#f4e7c5;
--gold:#d4a017;
--shadow:rgba(0,0,0,0.3);
}

*{
margin:0;
padding:0;
box-sizing:border-box;
scroll-behavior:smooth;
}

body{
font-family:'Poppins',sans-serif;
background:var(--navy);
color:white;
overflow-x:hidden;
}

/* NAVBAR */
nav{
display:flex;
justify-content:space-between;
align-items:center;
padding:15px 8%;
background:rgba(11,31,58,0.98);
backdrop-filter:blur(10px);
position:fixed;
width:100%;
z-index:1000;
transition:all 0.3s ease;
}

.logo{
font-family:'Playfair Display',serif;
font-size:28px;
color:var(--beige);
font-weight:600;
}

nav ul{
display:flex;
gap:30px;
list-style:none;
}

nav a{
color:white;
text-decoration:none;
font-weight:500;
transition:0.3s;
position:relative;
}

nav a::after{
content:'';
position:absolute;
bottom:-5px;
left:0;
width:0;
height:2px;
background:var(--beige);
transition:0.3s;
}

nav a:hover::after,
nav a.active::after{
width:100%;
}

nav a:hover{color:var(--beige);}

/* HAMBURGER */
.hamburger{
display:none;
flex-direction:column;
gap:4px;
cursor:pointer;
}

.hamburger span{
width:25px;
height:3px;
background:white;
transition:0.3s;
border-radius:2px;
}

.hamburger.active span:nth-child(1){transform:rotate(45deg) translate(6px,6px);}
.hamburger.active span:nth-child(2){opacity:0;}
.hamburger.active span:nth-child(3){transform:rotate(-45deg) translate(6px,-6px);}

/* HERO SLIDER */
.hero{
height:100vh;
position:relative;
overflow:hidden;
}

.slider{
position:relative;
height:100%;
width:400%;
display:flex;
transition:transform 0.8s cubic-bezier(0.25,0.46,0.45,0.94);
}

.slide{
width:25%;
height:100%;
position:relative;
background-size:cover;
background-position:center;
}

.slide-overlay{
position:absolute;
inset:0;
background:linear-gradient(rgba(0,0,0,.7),rgba(11,31,58,.9));
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
text-align:center;
padding:0 20px;
}

.hero-content h1{
font-family:'Playfair Display',serif;
font-size:clamp(42px,8vw,70px);
color:var(--beige);
margin-bottom:15px;
opacity:0;
transform:translateY(30px);
animation:fadeInUp 1s 0.5s forwards;
}

.hero-content p{
font-size:clamp(16px,3vw,20px);
margin-bottom:30px;
color:#eee;
opacity:0;
transform:translateY(30px);
animation:fadeInUp 1s 0.7s forwards;
max-width:600px;
}

.btn{
padding:16px 40px;
background:linear-gradient(135deg,var(--beige),#e8d9a8);
color:var(--navy);
border:none;
border-radius:50px;
font-weight:600;
font-size:16px;
cursor:pointer;
transition:all 0.3s ease;
text-transform:uppercase;
letter-spacing:1px;
box-shadow:0 8px 25px var(--shadow);
opacity:0;
transform:translateY(30px);
animation:fadeInUp 1s 0.9s forwards;
}

.btn:hover{
transform:translateY(-3px);
box-shadow:0 12px 35px var(--shadow);
}

/* ANIMATIONS */
@keyframes fadeInUp{
to{
opacity:1;
transform:translateY(0);
}
}

/* SERVICES */
section{padding:100px 8%;}

.services{
background:var(--navy2);
text-align:center;
}

section h2{
font-family:'Playfair Display',serif;
font-size:clamp(32px,6vw,48px);
color:var(--beige);
margin-bottom:60px;
}

.grid{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
gap:40px;
}

.card{
background:linear-gradient(145deg,rgba(255,255,255,0.08),rgba(255,255,255,0.02));
padding:40px 30px;
border-radius:20px;
transition:all 0.4s ease;
border:1px solid rgba(244,231,197,0.1);
position:relative;
overflow:hidden;
}

.card::before{
content:'';
position:absolute;
inset:0;
background:linear-gradient(45deg,var(--gold),transparent);
opacity:0;
transition:0.4s;
}

.card:hover::before{opacity:0.1;}
.card:hover{
transform:translateY(-15px) scale(1.02);
box-shadow:0 25px 50px var(--shadow);
}

.card i{
font-size:48px;
color:var(--beige);
margin-bottom:20px;
